{
  "ConnectionStrings": {
    "JobFinder": "Data Source=jobfinder.db"
  },
  "JobFinder": {
    "RefreshIntervalMinutes": 30,
    "MaximumRecords": 5000,
    "Theme": "system"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
