{
  "ConnectionStrings": {
    "JobFinder": "Data Source=jobfinder.db"
  },
  "JobFinder": {
    "RefreshIntervalMinutes": 30,
    "MaximumRecords": 5000,
    "Theme": "system",
    "EnableBackgroundCollection": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
